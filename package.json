{
  "name": "@astro-notion/loader",
  "version": "2.0.0-beta.1",
  "description": "Astro Content Loader to use Notion as a CMS",
  "keywords": [
    "astro-loader",
    "astro",
    "notion",
    "cms"
  ],
  "homepage": "https://github.com/astro-notion/notion-astro-loader",
  "bugs": {
    "url": "https://github.com/astro-notion/notion-astro-loader/issues"
  },
  "repository": "github:astro-notion/notion-astro-loader",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    },
    "./schemas/raw-properties": {
      "import": "./dist/schemas/raw-properties.js",
      "types": "./dist/schemas/raw-properties.d.ts"
    },
    "./schemas/transformed-properties": {
      "import": "./dist/schemas/transformed-properties.js",
      "types": "./dist/schemas/transformed-properties.d.ts"
    },
    "./schemas/page": {
      "import": "./dist/schemas/page.js",
      "types": "./dist/schemas/page.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --watch",
    "clean": "crossrm dist tsconfig.tsbuildinfo",
    "prepublishOnly": "pnpm run build",
    "test:compat": "pnpm test:compat:astro-6 && pnpm test:compat:astro-7",
    "test:compat:astro-6": "node tests/compatibility/run.mjs 6 6.4.8",
    "test:compat:astro-7": "node tests/compatibility/run.mjs 7 7.1.3",
    "typecheck": "tsc --noEmit && pnpm typecheck:tests",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@jsdevtools/rehype-toc": "^3.0.2",
    "@notionhq/client": "^5.23.2",
    "fs-extra": "^11.4.0",
    "kleur": "^4.1.5",
    "notion-rehype-k": "^1.1.6",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "astro": "7.1.3",
    "crossrm": "^1.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "^5.9.3",
    "vfile": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "astro": ">=6 <8"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=22.13.0"
  }
}
