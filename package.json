{
  "name": "@astro-notion/loader",
  "version": "2.0.0-beta.3",
  "description": "Astro Content Loader to use Notion as a CMS",
  "keywords": [
    "astro-loader",
    "astro",
    "notion",
    "cms"
  ],
  "homepage": "https://github.com/astro-notion/notion-astro-loader",
  "bugs": {
    "url": "https://github.com/astro-notion/notion-astro-loader/issues"
  },
  "repository": "github:astro-notion/notion-astro-loader",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    },
    "./schemas/raw-properties": {
      "import": "./dist/schemas/raw-properties.js",
      "types": "./dist/schemas/raw-properties.d.ts"
    },
    "./schemas/transformed-properties": {
      "import": "./dist/schemas/transformed-properties.js",
      "types": "./dist/schemas/transformed-properties.d.ts"
    },
    "./schemas/page": {
      "import": "./dist/schemas/page.js",
      "types": "./dist/schemas/page.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --watch",
    "clean": "crossrm dist tsconfig.tsbuildinfo",
    "prepublishOnly": "pnpm run build",
    "test:compat": "pnpm test:compat:astro-6 && pnpm test:compat:astro-7",
    "test:compat:astro-6": "node tests/compatibility/run.mjs 6 6.4.8",
    "test:compat:astro-7": "node tests/compatibility/run.mjs 7 7.1.3",
    "typecheck": "tsc --noEmit && pnpm typecheck:tests",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run --exclude \"tests/live/**\"",
    "test:coverage": "vitest run --coverage --exclude \"tests/live/**\"",
    "test:live": "vitest run tests/live/notion.test.ts",
    "test:live:preview": "node tests/live/run-preview.mjs"
  },
  "dependencies": {
    "@astro-notion/notion-rehype": "1.2.0",
    "@jsdevtools/rehype-toc": "^3.0.2",
    "@notionhq/client": "^5.26.0",
    "fs-extra": "^11.4.0",
    "kleur": "^4.1.5",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "astro": "7.2.4",
    "crossrm": "^1.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "^5.9.3",
    "vfile": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "astro": ">=6 <8"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "engines": {
    "node": ">=22.13.0"
  }
}
